# ── PHP Limits for File Uploads ────────────────────────────────
# Registration sends all document photos as base64 in one JSON payload,
# which can be 5-15MB. These limits ensure PHP doesn't silently truncate.
php_value upload_max_filesize 50M
php_value post_max_size 55M
php_value max_execution_time 300
php_value max_input_time 300
php_value memory_limit 256M

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route all /api requests to the PHP proxy script
  # -------------------------------------------------------------
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ api/index.php [QSA,L]

  # 2. SPA routing fallback
  # -------------------------------------------------------------
  # Redirects all other requests to index.html so React Router handles the pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
