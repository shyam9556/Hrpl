# ════════════════════════════════════════════════════════════
# HIGHLIGHT PRO — SERVER ENVIRONMENT CONFIGURATION
# ════════════════════════════════════════════════════════════
# Copy this file to .env and fill in ALL values before running.
# NEVER commit .env to version control.
# ════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── MySQL Database ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=highlight_pro
DB_USER=root
DB_PASSWORD=your_strong_password_here

# ─── JWT Authentication ────────────────────────────────────
# REQUIRED: Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 64 characters. NEVER use a guessable value.
JWT_SECRET=replace_with_output_of_above_command_min_64_chars
JWT_EXPIRES_IN=24h

# ─── SMTP Email (for password reset emails) ───────────────
# Leave SMTP_HOST empty to disable email (password reset links will only log to console).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=noreply@highlightpro.in
SMTP_FROM_NAME=Highlight Pro

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ─── Frontend URL (for CORS and password reset links) ─────
# In production, set this to your actual domain (NO trailing slash).
# Example: https://app.highlightpro.in
CLIENT_URL=https://your-production-domain.com

# ─── PDF Fonts (optional — for better PDF quality) ────────
# Place Poppins-Regular.ttf and Poppins-Bold.ttf in:
#   solar-app/public/fonts/
# Download from: https://fonts.google.com/specimen/Poppins
# If not present, the PDF generator falls back to Helvetica (still works).
